{
  // Overrides the global "afterDelay": formatOnSave never runs on a timer save,
  // so the file would stay unformatted no matter how often it is saved.
  "files.autoSave": "onFocusChange",
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  // "always" also covers focus-change saves; "explicit" would only cover Cmd+S.
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "always",
    "source.organizeImports.biome": "always"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "typescript.tsdk": "node_modules/typescript/lib"
}
